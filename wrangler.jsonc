{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pack-labs-packaging-studio",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
